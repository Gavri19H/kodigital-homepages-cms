# .env.example
#
# Top-level repo env file. The kodigital-homepages-cms Worker reads its
# secrets from `api/.dev.vars` (NOT from this file) when running under
# `wrangler dev`. See `api/.dev.vars.example` and `docs/secrets-manifest.md`
# for the runtime secret contract.
#
# This top-level `.env` file is reserved for tooling that runs OUTSIDE
# the Worker (e.g. local scripts, optional CI helpers). All values are
# placeholders. Never commit real secrets.

# Optional: override the deploy environment name used by tooling.
APP_ENV=local

# Optional: pass through for local helper scripts that hit the Cloudflare
# API directly (most contributors do not need this).
# CLOUDFLARE_ACCOUNT_ID=PLACEHOLDER
