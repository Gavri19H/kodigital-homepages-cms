{
  "name": "kodigital-homepages-cms-api",
  "version": "0.1.0",
  "description": "Worker API for kodigital-homepages-cms (Phase 0 scaffold)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:report": "playwright show-report",
    "build:conversions-admin": "tsx scripts/build-conversions-admin.ts",
    "build:leadgen-runtime": "tsx scripts/build-leadgen-runtime.ts",
    "build:icons": "node scripts/build-icons.mjs",
    "build:fonts": "node scripts/build-fonts.mjs",
    "verify:no-legacy-prod-refs": "tsx scripts/verify/assert-no-legacy-prod-refs.ts",
    "verify:infra": "tsx scripts/verify/infra-contract.ts",
    "verify:required-secrets": "tsx scripts/verify/required-secrets.ts",
    "verify:worker-config": "tsx scripts/verify/worker-config.ts",
    "verify:conversions-admin": "tsx scripts/build-conversions-admin.ts --check",
    "verify:conversions-actor-contract": "vitest run test/conversions-actor-envelope.test.ts test/conversions-service-proxy.test.ts test/conversions-bootstrap-warning.test.ts",
    "verify:leadgen-runtime": "tsx scripts/verify/leadgen-runtime.ts",
    "verify:jargon": "node scripts/jargon-scan.mjs",
    "verify:jargon:strict": "node scripts/jargon-scan.mjs --strict",
    "verify:golden-regions": "node scripts/golden-allowlist.mjs",
    "verify:golden-regions:strict": "node scripts/golden-allowlist.mjs --strict",
    "verify:orphan-scan": "node scripts/verify/leadgen-orphan-scan.mjs",
    "verify:all": "npm run verify:no-legacy-prod-refs && npm run verify:infra && npm run verify:worker-config && npm run verify:conversions-admin && npm run verify:conversions-actor-contract && npm run verify:leadgen-runtime && npm run verify:jargon:strict && npm run verify:golden-regions:strict",
    "smoke:cms-domain": "tsx scripts/smoke/cms-domain.ts",
    "smoke:local": "curl -fsS http://localhost:8787/health",
    "cost:estimate": "tsx scripts/cost/estimate.ts",
    "db:explain-homepage": "tsx scripts/db/explain-homepage.ts",
    "db:explain-article": "tsx scripts/db/explain-article.ts",
    "db:migrate:local": "wrangler d1 migrations apply kodigital-homepages-cms-db --local",
    "seed:local": "tsx scripts/seed-local.ts",
    "seed:leadgen-fixture": "tsx scripts/seed-leadgen-fixture.ts",
    "db:reset:local": "rm -rf .wrangler/state/v3 && npm run db:migrate:local && npm run seed:local",
    "db:migrate:remote": "wrangler d1 migrations apply kodigital-homepages-cms-db --remote",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "hono": "^4.6.3",
    "jose": "^5.10.0",
    "preact": "10.29.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260729.1",
    "@playwright/test": "1.59.1",
    "@types/node": "^22.7.4",
    "esbuild": "0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  },
  "engines": {
    "node": ">=20"
  }
}
