:"site-1","site_name":"Site One","badge":"Active"},{"site_id":"site-2","site_name":"Site Two","badge":"Not activated yet"}],"overrides":null,"preflight":{"ok":true,"quote_id":"lgq_01KZ4QJ31GPDJDZRKV9ENJ6618","funnel_id":"lgf_01KZ4QJ31HNEVPF1WFR3QDPWNH","funnel_variant_id":"lgn_01KZ4QJ31H40MF9GSCPDK4CTVQ","blocks":[],"computed_at":1785791581244,"problems":[]}}</script>
