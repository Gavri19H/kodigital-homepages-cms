+     o.value = '';
+     o.textContent = placeholder;
+     sel.appendChild(o);
+     var i;
+     for (i = 0; i < entries.length; i++) {
+       o = document.createElement('option');
+       o.value = entries[i].value;
+       o.textContent = entries[i].label;
