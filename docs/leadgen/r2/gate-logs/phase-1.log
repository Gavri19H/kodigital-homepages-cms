+       groupToggles[gt].addEventListener('keydown', function (ev) {
+         if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); onGroupToggleActivate.call(this); }
+       });
+     }
+     // §5.1/§5.5 search: case-insensitive substring of the tile's data-name,
