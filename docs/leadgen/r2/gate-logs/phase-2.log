      var fk = t.closest('[data-funnel-kebab]');
      if (fk) { ev.stopPropagation(); var fcol = fk.closest('[data-funnel-col]'); openMenu('funnel', fk, { funnelPub: fcol.getAttribute('data-funnel-public-id') }); return; }
