        var from = Number(d.el.getAttribute('data-page-index'));
        var toIdx = t.pageEl ? Number(t.pageEl.getAttribute('data-page-index')) : (pf.model.pages.length - 1);
        if (from < 0 || toIdx < 0 || from === toIdx) { return; }
