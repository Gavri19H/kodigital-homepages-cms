      if (ck) { ev.stopPropagation(); var chip2 = ck.closest('[data-sec-chip]'); var which = ck.getAttribute('data-chip-menu'); openMenu(which, ck, { chip: chip2 }); return; }
      var pk = t.closest('[data-page-kebab]');
