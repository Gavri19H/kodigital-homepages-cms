    var BOARD = {};
    try { BOARD = JSON.parse((dataEl && (dataEl.textContent || dataEl.innerText)) || '{}'); } catch (eBoard) { BOARD = {}; }
    var quoteId = BOARD.quote_public_id || '';
    var API = '/api/admin/leadgen';
    // §8.2 (S5.3) shared-slot editors: the entry-known condition fields (grounded
    // in resolver.ENTRY_KNOWN_SLOT_FIELDS via SSR) + the op vocabulary. Injected
    // once so the ruled-case builder never invents a field the save-time scope
    // validator would reject.
    var SLOT_RULE_FIELDS = [{"value":"state","label":"State"},{"value":"device","label":"Device"},{"value":"utm_source","label":"UTM source"},{"value":"utm_medium","label":"UTM medium"},{"value":"utm_content","label":"UTM content"},{"value":"hour","label":"Hour (0-23, UTC)"},{"value":"weekday","label":"Weekday (0-6, UTC)"}];
    var SLOT_RULE_OPS = [{"value":"eq","label":"equals"},{"value":"neq","label":"does not equal"},{"value":"gt","label":"greater than"},{"value":"lt","label":"less than"},{"value":"gte","label":"at least"},{"value":"lte","label":"at most"}];

    function reloadPage() { window.location.reload(); }
    function req(method, url, body) {
      return fetch(url, {
        method: method, credentials: 'same-origin',
        headers: { 'content-type': 'application/json', 'Accept': 'application/json' },
        body: body === undefined ? undefined : JSON.stringify(body)
      }).then(function (r) {
        return r.json().catch(function () { return null; }).then(function (j) { return { ok: r.ok, status: r.status, body: j }; });
      });
    }
    function firstFieldError(body) {
      if (body && body.fields) { var k; for (k in body.fields) { if (Object.prototype.hasOwnProperty.call(body.fields, k)) { return body.fields[k]; } } }
      return (body && body.error) ? body.error : 'Something went wrong. Please try again.';
    }
    function funnelByPublic(pub) {
      var fs = BOARD.funnels || []; var i;
      for (i = 0; i < fs.length; i++) { if (fs[i].public_id === pub) { return fs[i]; } }
      return null;
    }
    function orderedFunnels() {
