    function makeRuledCase(field, op, value, sectionPub) {
      var row = document.createElement('div'); row.className = 'lg-ruled-case'; row.setAttribute('data-ruled-case', '1');
      var fSel = document.createElement('select'); fSel.className = 'form-select'; fSel.setAttribute('data-ruled-field', '1'); fSel.setAttribute('aria-label', 'Condition field');
      var i; for (i = 0; i < SLOT_RULE_FIELDS.length; i++) { var o = document.createElement('option'); o.value = SLOT_RULE_FIELDS[i].value; o.appendChild(document.createTextNode(SLOT_RULE_FIELDS[i].label)); if (SLOT_RULE_FIELDS[i].value === field) { o.selected = true; } fSel.appendChild(o); }
