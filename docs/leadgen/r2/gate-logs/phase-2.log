    }
    var searchInput = document.querySelector('.toolbar-search input[name="search"]');
    if (searchInput && !searchInput.form) {
      searchInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          applyFilter('search', this.value);
        }
      });
    }
