ata-role-pick="button_primary_bg" data-role-pick-for="progress.color_role" title="Button" aria-label="Button"></button><button type="button" class="lg-role-swatch" data-role-pick="button_primary_text" data-role-pick-for="progress.color_role" title="Button text" aria-label="Button text"></button><button type="button" class="lg-role-swatch" data-role-pick="button_secondary_bg" data-role-pick-for="progress.color_role" title="Secondary button" aria-label="Secondary button"></button></div></div>
