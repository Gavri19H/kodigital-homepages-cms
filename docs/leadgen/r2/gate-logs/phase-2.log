      var secSel = document.createElement('select'); secSel.className = 'form-select'; secSel.setAttribute('data-ruled-section', '1'); secSel.setAttribute('aria-label', 'Show section'); fillSectionSelect(secSel, sectionPub, true);
      var rm = document.createElement('button'); rm.type = 'button'; rm.className = 'btn btn-sm btn-outline'; rm.setAttribute('data-ruled-case-remove', '1'); rm.appendChild(document.createTextNode('Remove'));
