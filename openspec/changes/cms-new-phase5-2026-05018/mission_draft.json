{
  "contract_version": "1.0.0",
  "change_id": "cms-new-phase5-2026-05018",
  "branch_name": "mission/cms-new-phase5-2026-05018",
  "tier": "COMPLEX",
  "main_goal": {
    "text": "Implement generic Home + Article public templates in the standalone CMS Worker so a tenant content domain renders the approved 13-section Home and 12-section Article using per-site brand tokens via SiteContext, with no TheIWise visible brand and no cms.kodigital.app leak.",
    "entity": "kodigital-homepages-cms public Worker (api/src/public/)",
    "action": "render Home + Article templates from per-site CMS data",
    "metric": {
      "name": "renderhome_function_exported",
      "comparator": ">=",
      "expected_value": 1
    },
    "source_of_truth": {
      "source_id": "SP-SPEC-001",
      "source_type": "file",
      "method": "grep",
      "canonical_path": "api/src/public/templates/home.ts",
      "entity": "rendered_home_html",
      "metric": "renderhome_function_exported",
      "parser_name": "parse_grep_count",
      "parser_version": "1.0.0",
      "value_path": "$.count"
    },
    "forbidden_substitutes": [
      "theiwise.com",
      "TheIWise",
      "theiwise",
      "a2z-cf-cms-v1-api",
      "a2z-cf-cms-v1-db"
    ],
    "ui_surface": "/, /article/:slug, /category/:slug, /page/:slug, /assets/public.css, /assets/public.js",
    "api_surface": "Hono Worker public router",
    "storage_surface": "D1 (sites, site_settings, articles, categories, site_categories, category_verticals, media, pages)",
    "failure_criterion": "Any rendered output contains TheIWise/theiwise outside docs/reference allowlist; href=\"#\" present in rendered home/article; section order differs from PART 1/PART 2; .article-shell omits minmax(0, 1fr); cms.kodigital.app appears in any public-domain body; any verify:* script non-zero.",
    "evidence_required": [
      "vitest pass for all 22 stories",
      "tsc --noEmit exit 0",
      "verify:no-legacy-prod-refs exit 0",
      "verify:infra exit 0",
      "verify:worker-config exit 0"
    ]
  },
